{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "packageRules": [
    {
      "description": "Keine Digest-Updates fuer GitHub Actions (Pinning bleibt aktiv)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Minor- und Patch-Updates automatisch mergen",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
